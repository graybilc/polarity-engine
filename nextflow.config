manifest {
    name            = 'polarity-engine'
    description     = 'Structural bioinformatics pipeline for polarity engine'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
}

env {
    PYTHONPATH       = "${projectDir}:${projectDir}/src:\${PYTHONPATH:-}"
    PYTHONUNBUFFERED = '1'
}

profiles {
    standard {
        process.executor = 'local'
    }
}

params {
    outdir = 'output'
    output = 'simulation_trajectories.csv'
    alpha = 1.2
    regime = 'processive'
    mimic_res = 'GLU'
}

process {
    container = 'polarity-engine:latest'
    errorStrategy = 'finish'
}
